# WorkForge backend — copy to .env and load in your shell or IDE (do not commit .env).
# Values mirror application.yml and application-dev.yml defaults unless noted.

# ---- Spring ----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---- PostgreSQL (dev profile) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workforge
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- JWT (set a long random secret in staging/production) ----
JWT_SECRET=change-me-in-production-use-a-long-random-value
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ---- CORS (comma-separated origins) ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- File uploads ----
FILE_STORAGE_LOCATION=./data/attachments

# ---- Bootstrap admin (required on first startup to create admin user) ----
WORKFORGE_ADMIN_EMAIL=admin@workforge.local
WORKFORGE_ADMIN_USERNAME=admin
WORKFORGE_ADMIN_PASSWORD=

# ---- Rate limiting ----
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_PERIOD_SECONDS=60
