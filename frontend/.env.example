# WorkForge frontend — copy to .env.local or .env (do not commit secrets).
# Vite exposes only variables prefixed with VITE_.

# API base URL. Use /api/v1 with the Vite dev proxy (see vite.config.ts).
# For production, set to your public API origin, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1
