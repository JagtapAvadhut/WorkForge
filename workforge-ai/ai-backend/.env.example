# WorkForge AI backend — copy to .env locally (do not commit secrets).
SERVER_PORT=8090
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIMENSIONS=768
AI_DOCUMENTS_MAX_TOP_K=20
AI_RAG_DEFAULT_TOP_K=5
AI_RAG_MAX_TOP_K=20
AI_RAG_SIMILARITY_THRESHOLD=0.45
AI_TOOLS_DEFAULT_SEARCH_LIMIT=10
AI_TOOLS_MAX_SEARCH_LIMIT=50
AI_AGENT_MAX_STEPS=5
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workforge_ai
DB_USERNAME=postgres
DB_PASSWORD=postgres
